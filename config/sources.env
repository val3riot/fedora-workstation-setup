# Endpoint esterni usati dal setup.
# Se un vendor cambia URL, aggiorna questo file invece dei moduli.
# config/local.env può sovrascrivere qualunque valore qui definito.

# Shell / runtime language managers
OH_MY_ZSH_INSTALL_URL="https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh"
SDKMAN_INSTALL_URL="https://get.sdkman.io?ci=true&rcupdate=false"
NVM_INSTALL_URL="https://raw.githubusercontent.com/nvm-sh/nvm/master/install.sh"
MINICONDA_INSTALLER_URL="https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh"

# Docker
DOCKER_REPO_URL="https://download.docker.com/linux/fedora/docker-ce.repo"
DOCKER_DESKTOP_RPM_URL="https://desktop.docker.com/linux/main/amd64/docker-desktop-x86_64.rpm"

# VS Code
VSCODE_GPG_KEY_URL="https://packages.microsoft.com/keys/microsoft.asc"
VSCODE_REPO_BASEURL="https://packages.microsoft.com/yumrepos/vscode"

# Applicazioni desktop
FLATHUB_REPO_URL="https://dl.flathub.org/repo/flathub.flatpakrepo"
DBEAVER_RPM_URL="https://dbeaver.io/files/dbeaver-ce-latest-stable.x86_64.rpm"
BRUNO_RELEASES_API_URL="https://api.github.com/repos/usebruno/bruno/releases/latest"
JETBRAINS_TOOLBOX_API_URL="https://data.services.jetbrains.com/products/releases?code=TBA&latest=true&type=release"
